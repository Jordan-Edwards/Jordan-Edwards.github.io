@@ -0,0 +1,40 @@
+#ifndef LIBS_NEWDISPLAY_LOOPSTRIPCONTROL_H_
+#define LIBS_NEWDISPLAY_LOOPSTRIPCONTROL_H_
+
+#ifdef TRACKER_MINI
+
+#include "displayControls.h"
+
+// Loops screen: the row of slice cells under the waveform. The four cells the value keys
+// play carry the key name; the cell under the playhead is lit; a held pad gets a frame.
+struct strLoopStripData
+{
+    static constexpr int kPads = 4;
+
+    uint8_t count = 8;   // 8 or 16 slices
+    uint8_t padBase = 0; // slice played by the first value key
+    int8_t playing = -1; // slice under the playhead, -1 = none
+    int8_t held = -1;    // slice of the held pad, -1 = none
+};
+
+class cLoopStrip : public cDisplayControl
+{
+  public:
+    cLoopStrip(strControlProperties* properties);
+    virtual ~cLoopStrip();
+
+    virtual void update();
+
+    virtual void setStyle(uint32_t style);
+    virtual void setText(const char* text);
+    virtual void setValue(int value);
+    virtual void setColors(const uint32_t* colors);
+    virtual void setData(void* data);
+
+  private:
+    strLoopStripData* data;
+};
+
+#endif // TRACKER_MINI
+
+#endif /* LIBS_NEWDISPLAY_LOOPSTRIPCONTROL_H_ */
