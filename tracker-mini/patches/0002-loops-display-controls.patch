diff --git a/core/libs/NewDisplay/loopHead.cpp b/core/libs/NewDisplay/loopHead.cpp
new file mode 100644
index 0000000..89dd425
--- /dev/null
+++ b/core/libs/NewDisplay/loopHead.cpp
@@ -0,0 +1,230 @@
+#ifdef TRACKER_MINI
+
+#include "FT812.h"
+
+#include "display.h"
+#include "loopHeadControl.h"
+
+// colors: [0] playhead line, [1] glow, tail and edge flash, [2] arm countdown, [3] beat lamps
+
+static constexpr int16_t kLampsX = 724;
+static constexpr int16_t kLampsStep = 18;
+static constexpr int16_t kLampsY = 50;
+static constexpr int kTailParts = 5;
+
+cLoopHead::cLoopHead(strControlProperties* properties)
+  : cDisplayControl(controlIdLoopHead, 1)
+{
+    colorsCount = 4;
+    colors = display.getTheme().waveformProgressColors;
+    data = nullptr;
+
+    if (properties == nullptr)
+    {
+        this->style = 0;
+        return;
+    }
+
+    colors = (properties->colors == nullptr) ? colors : properties->colors;
+
+    posX = properties->x;
+    posY = properties->y;
+    width = properties->w;
+    height = properties->h;
+
+    data = (strLoopHeadData*)properties->data;
+
+    setStyle(properties->style);
+}
+
+cLoopHead::~cLoopHead()
+{
+}
+
+//--------------------------------------------------------------------------------
+void cLoopHead::setStyle(uint32_t style)
+{
+    this->style = style;
+}
+
+void cLoopHead::setText(const char*)
+{
+}
+
+void cLoopHead::setValue(int value)
+{
+    this->value = value;
+}
+
+void cLoopHead::setColors(const uint32_t* colors)
+{
+    this->colors = colors;
+}
+
+void cLoopHead::setData(void* data)
+{
+    this->data = (strLoopHeadData*)data;
+}
+
+//--------------------------------------------------------------------------------
+// Three stacked translucent bars: wide and faint, then narrower and brighter.
+void cLoopHead::drawFlash(int16_t edgeX, uint8_t level)
+{
+    static const int16_t halfWidth[3] = { 12, 5, 1 };
+    static const uint8_t divider[3] = { 4, 2, 1 };
+
+    API_BEGIN(RECTS);
+    for (int i = 0; i < 3; i++)
+    {
+        API_COLOR_A(level / divider[i]);
+        API_VERTEX2F(edgeX - halfWidth[i], posY);
+        API_VERTEX2F(edgeX + halfWidth[i], posY + height);
+    }
+    API_END();
+}
+
+void cLoopHead::update()
+{
+    if (data == nullptr)
+    {
+        return;
+    }
+
+    API_SAVE_CONTEXT();
+
+    // beat lamps in the info row
+    if (data->lamps)
+    {
+        API_COLOR(colors[3]);
+        API_POINT_SIZE(5 * 16);
+        API_BEGIN(FTPOINTS);
+        for (int i = 0; i < 4; i++)
+        {
+            API_COLOR_A(i == data->beat ? 255 : 50);
+            API_VERTEX2F(kLampsX + kLampsStep * i, kLampsY);
+        }
+        API_END();
+        API_COLOR_A(255);
+    }
+
+    // arm countdown: a 2 px line just above the wave, filling up to the bar
+    if (data->countdownPx > 0)
+    {
+        API_COLOR(colors[2]);
+        API_LINE_WIDTH(16);
+        API_BEGIN(LINES);
+        API_VERTEX2F(posX, posY - 3);
+        API_VERTEX2F(posX + data->countdownPx, posY - 3);
+        API_END();
+    }
+
+    const int16_t headPx = (int16_t)(posX + data->x16 / 16);
+
+    // direction arrow, in the ruler band above the wave
+    if (data->show && data->dir != 0)
+    {
+        const int16_t s = data->dir;
+        const int16_t y = posY - 13;
+
+        API_COLOR(colors[0]);
+        API_LINE_WIDTH(16);
+        API_BEGIN(LINE_STRIP);
+        API_VERTEX2F(headPx + s * 3, y - 5);
+        API_VERTEX2F(headPx + s * 9, y);
+        API_VERTEX2F(headPx + s * 3, y + 5);
+        API_END();
+    }
+
+    // everything below stays inside the wave area
+    API_SCISSOR_XY(posX, posY);
+    API_SCISSOR_SIZE(width, height);
+
+    API_BLEND_FUNC(SRC_ALPHA, ONE);
+    API_COLOR(colors[1]);
+    API_LINE_WIDTH(16);
+
+    if (data->flashStart > 0)
+    {
+        drawFlash(posX + data->regionStartPx, data->flashStart);
+    }
+    if (data->flashEnd > 0)
+    {
+        drawFlash(posX + data->regionEndPx, data->flashEnd);
+    }
+
+    if (data->show)
+    {
+        // The playhead is placed in 1/16 px steps so a slow loop glides instead of stepping.
+        API_VERTEX_FORMAT(4);
+
+        const int16_t x = (int16_t)(posX * 16 + data->x16);
+        const int16_t top = (int16_t)(posY * 16);
+        const int16_t bottom = (int16_t)((posY + height) * 16);
+
+        // tail: five translucent pieces, fading away from the playhead
+        if (data->dir != 0 && data->tailPx > 0)
+        {
+            const int32_t tail16 = (int32_t)data->tailPx * 16;
+
+            API_BEGIN(RECTS);
+            for (int j = 0; j < kTailParts; j++)
+            {
+                int32_t nearX = x - data->dir * ((tail16 * j) / kTailParts);
+                int32_t farX = x - data->dir * ((tail16 * (j + 1)) / kTailParts);
+                int32_t left = (nearX < farX) ? nearX : farX;
+                int32_t right = (nearX < farX) ? farX : nearX;
+
+                // RECTS grow by the line width on every side: pull the ends in by 1 px
+                // so neighbours meet without a brighter seam.
+                left += 16;
+                right -= 16;
+                if (right <= left)
+                {
+                    continue;
+                }
+                if (left < -1600)
+                {
+                    left = -1600;
+                }
+                if (right > 14400)
+                {
+                    right = 14400;
+                }
+
+                API_COLOR_A((uint8_t)(110 - j * 22));
+                API_VERTEX2F((int16_t)left, top);
+                API_VERTEX2F((int16_t)right, bottom);
+            }
+            API_END();
+        }
+
+        // glow: a 17 px and a 9 px line behind the playhead
+        API_BEGIN(LINES);
+        API_LINE_WIDTH(136);
+        API_COLOR_A(45);
+        API_VERTEX2F(x, top);
+        API_VERTEX2F(x, bottom);
+        API_LINE_WIDTH(72);
+        API_COLOR_A(100);
+        API_VERTEX2F(x, top);
+        API_VERTEX2F(x, bottom);
+        API_END();
+
+        // the playhead itself: 3 px, opaque
+        API_BLEND_FUNC(SRC_ALPHA, ONE_MINUS_SRC_ALPHA);
+        API_COLOR(colors[0]);
+        API_COLOR_A(255);
+        API_LINE_WIDTH(24);
+        API_BEGIN(LINES);
+        API_VERTEX2F(x, top);
+        API_VERTEX2F(x, bottom);
+        API_END();
+
+        API_VERTEX_FORMAT(0);
+    }
+
+    API_BLEND_FUNC(SRC_ALPHA, ONE_MINUS_SRC_ALPHA);
+    API_RESTORE_CONTEXT();
+}
+
+#endif // TRACKER_MINI
diff --git a/core/libs/NewDisplay/loopHeadControl.h b/core/libs/NewDisplay/loopHeadControl.h
