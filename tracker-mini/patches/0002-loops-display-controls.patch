@@ -0,0 +1,48 @@
+#ifndef LIBS_NEWDISPLAY_LOOPHEADCONTROL_H_
+#define LIBS_NEWDISPLAY_LOOPHEADCONTROL_H_
+
+#ifdef TRACKER_MINI
+
+#include "displayControls.h"
+
+// Loops screen: everything that moves. The playhead with its glow and tail, the direction
+// arrow, the flash at the loop edges, the arm countdown line and the beat lamps. It is a
+// small display list of its own, so the heavy waveform is not rebuilt for every frame.
+struct strLoopHeadData
+{
+    uint8_t show = 0;      // draw the playhead
+    int32_t x16 = 0;       // playhead x in 1/16 px (0..12800)
+    int8_t dir = 0;        // +1 right, -1 left, 0 unknown (no tail, no arrow)
+    uint16_t tailPx = 16;  // tail length, on the side the playhead came from
+    uint8_t flashStart = 0; // 0..255, flash on the region start edge
+    uint8_t flashEnd = 0;   // 0..255, flash on the region end edge
+    uint16_t regionStartPx = 0;
+    uint16_t regionEndPx = 800;
+    uint16_t countdownPx = 0; // arm countdown line length, 0 = none
+    uint8_t lamps = 0;        // show the four beat lamps
+    int8_t beat = -1;         // lit lamp 0..3, -1 = none
+};
+
+class cLoopHead : public cDisplayControl
+{
+  public:
+    cLoopHead(strControlProperties* properties);
+    virtual ~cLoopHead();
+
+    virtual void update();
+
+    virtual void setStyle(uint32_t style);
+    virtual void setText(const char* text);
+    virtual void setValue(int value);
+    virtual void setColors(const uint32_t* colors);
+    virtual void setData(void* data);
+
+  private:
+    void drawFlash(int16_t edgeX, uint8_t level);
+
+    strLoopHeadData* data;
+};
+
+#endif // TRACKER_MINI
+
+#endif /* LIBS_NEWDISPLAY_LOOPHEADCONTROL_H_ */
diff --git a/core/libs/NewDisplay/loopStrip.cpp b/core/libs/NewDisplay/loopStrip.cpp
