+++ b/core/libs/NewDisplay/loopStrip.cpp
@@ -0,0 +1,151 @@
+#ifdef TRACKER_MINI
+
+#include "FT812.h"
+
+#include "display.h"
+#include "loopStripControl.h"
+
+// colors: [0] pad text, [1] slice number, [2] cell background, [3] playing / held
+
+static const char* const padCaptions[strLoopStripData::kPads] = { "+10", "+1", "-1", "-10" };
+
+cLoopStrip::cLoopStrip(strControlProperties* properties)
+  : cDisplayControl(controlIdLoopStrip, 1)
+{
+    colorsCount = 4;
+    colors = display.getTheme().activeLabelsColors;
+    data = nullptr;
+    font = &fonts[0];
+
+    if (properties == nullptr)
+    {
+        this->style = 0;
+        return;
+    }
+
+    colors = (properties->colors == nullptr) ? colors : properties->colors;
+
+    posX = properties->x;
+    posY = properties->y;
+    width = properties->w;
+    height = properties->h;
+
+    data = (strLoopStripData*)properties->data;
+
+    setStyle(properties->style);
+}
+
+cLoopStrip::~cLoopStrip()
+{
+}
+
+//--------------------------------------------------------------------------------
+void cLoopStrip::setStyle(uint32_t style)
+{
+    this->style = style;
+
+    int8_t textFont = FONT_INDEX_FROM_STYLE;
+    textFont = (textFont >= 0) ? textFont : 0;
+    font = &fonts[textFont];
+}
+
+void cLoopStrip::setText(const char*)
+{
+}
+
+void cLoopStrip::setValue(int value)
+{
+    this->value = value;
+}
+
+void cLoopStrip::setColors(const uint32_t* colors)
+{
+    this->colors = colors;
+}
+
+void cLoopStrip::setData(void* data)
+{
+    this->data = (strLoopStripData*)data;
+}
+
+//--------------------------------------------------------------------------------
+void cLoopStrip::update()
+{
+    if (data == nullptr || data->count == 0)
+    {
+        return;
+    }
+
+    API_SAVE_CONTEXT();
+
+    const int count = data->count;
+    const int16_t top = posY + 2;
+    const int16_t bottom = posY + height - 3;
+    const int16_t textY = posY + height / 2;
+
+    // cell backgrounds
+    API_LINE_WIDTH(16);
+    API_BEGIN(RECTS);
+    for (int k = 0; k < count; k++)
+    {
+        const int16_t x0 = posX + (width * k) / count + 3;
+        const int16_t x1 = posX + (width * (k + 1)) / count - 4;
+        const bool pad = (k >= data->padBase && k < data->padBase + strLoopStripData::kPads);
+
+        if (k == data->playing)
+        {
+            API_COLOR(colors[3]);
+            API_COLOR_A(pad ? 255 : 150);
+        }
+        else
+        {
+            API_COLOR(colors[2]);
+            API_COLOR_A(pad ? 255 : 90);
+        }
+
+        API_VERTEX2F(x0, top);
+        API_VERTEX2F(x1, bottom);
+    }
+    API_END();
+    API_COLOR_A(255);
+
+    // frame round the held pad's slice
+    if (data->held >= 0 && data->held < count)
+    {
+        const int16_t x0 = posX + (width * data->held) / count + 2;
+        const int16_t x1 = posX + (width * (data->held + 1)) / count - 3;
+
+        API_COLOR(colors[0]);
+        API_LINE_WIDTH(24);
+        API_BEGIN(LINE_STRIP);
+        API_VERTEX2F(x0, top - 1);
+        API_VERTEX2F(x1, top - 1);
+        API_VERTEX2F(x1, bottom + 1);
+        API_VERTEX2F(x0, bottom + 1);
+        API_VERTEX2F(x0, top - 1);
+        API_END();
+        API_LINE_WIDTH(16);
+    }
+
+    // captions: key names on the four pad cells, slice numbers on the rest
+    for (int k = 0; k < count; k++)
+    {
+        const int16_t cx = posX + (width * (2 * k + 1)) / (2 * count);
+        const int pad = k - data->padBase;
+
+        if (pad >= 0 && pad < strLoopStripData::kPads)
+        {
+            API_COLOR(colors[0]);
+            API_CMD_TEXT(cx, textY, font->handle, OPT_CENTER, padCaptions[pad]);
+        }
+        else
+        {
+            API_COLOR(colors[1]);
+            API_CMD_NUMBER(cx, textY, font->handle, OPT_CENTER, k + 1);
+        }
+    }
+
+    API_RESTORE_CONTEXT();
+}
+
+#endif // TRACKER_MINI
