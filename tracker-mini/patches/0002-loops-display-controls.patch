+++ b/core/libs/NewDisplay/loopWave.cpp
@@ -0,0 +1,187 @@
+#ifdef TRACKER_MINI
+
+#include "FT812.h"
+
+#include "display.h"
+#include "loopWaveControl.h"
+
+// colors: [0] bars, [1] ruler and slice lines
+
+cLoopWave::cLoopWave(strControlProperties* properties)
+  : cDisplayControl(controlIdLoopWave, 1)
+{
+    colorsCount = 2;
+    colors = display.getTheme().waveformColors;
+    data = nullptr;
+    font = &fonts[4];
+
+    if (properties == nullptr)
+    {
+        this->style = 0;
+        return;
+    }
+
+    colors = (properties->colors == nullptr) ? colors : properties->colors;
+
+    posX = properties->x;
+    posY = properties->y;
+    width = properties->w;
+    height = properties->h;
+
+    data = (strLoopWaveData*)properties->data;
+
+    setStyle(properties->style);
+}
+
+cLoopWave::~cLoopWave()
+{
+}
+
+//--------------------------------------------------------------------------------
+void cLoopWave::setStyle(uint32_t style)
+{
+    this->style = style;
+
+    int8_t textFont = FONT_INDEX_FROM_STYLE;
+    textFont = (textFont >= 0) ? textFont : 4;
+    font = &fonts[textFont];
+}
+
+void cLoopWave::setText(const char*)
+{
+}
+
+void cLoopWave::setValue(int value)
+{
+    this->value = value;
+}
+
+void cLoopWave::setColors(const uint32_t* colors)
+{
+    this->colors = colors;
+}
+
+void cLoopWave::setData(void* data)
+{
+    this->data = (strLoopWaveData*)data;
+}
+
+//--------------------------------------------------------------------------------
+void cLoopWave::drawRuler()
+{
+    // The ruler sits in the 20 px above the wave: ticks end 6 px above it.
+    const int16_t bottom = posY - 6;
+    const int32_t start = posX + data->regionStartPx;
+    const int32_t span = (int32_t)data->regionEndPx - (int32_t)data->regionStartPx;
+
+    if (span <= 0)
+    {
+        return;
+    }
+
+    const bool fit = data->rulerBeats > 0;
+    const int ticks = fit ? data->rulerBeats : data->slices;
+
+    if (ticks <= 0)
+    {
+        return;
+    }
+
+    // Past 8 bars only the bar ticks are drawn: beat ticks would be 12 px apart, and it
+    // keeps this control's command list about the size of a stock waveform's.
+    const bool beatTicks = !fit || ticks <= 32;
+
+    API_COLOR(colors[1]);
+    API_LINE_WIDTH(8);
+    API_BEGIN(LINES);
+    for (int k = 0; k <= ticks; k++)
+    {
+        const bool barTick = fit && (k % 4) == 0;
+        if (!barTick && !beatTicks)
+        {
+            continue;
+        }
+        int16_t x = (int16_t)(start + (span * k) / ticks);
+        if (x > 799)
+        {
+            x = 799;
+        }
+        API_VERTEX2F(x, bottom - (barTick ? 12 : 6));
+        API_VERTEX2F(x, bottom);
+    }
+    API_END();
+
+    if (fit)
+    {
+        // bar numbers, when there is room for them
+        const int bars = (data->rulerBeats + 3) / 4;
+        if (bars > 0 && span / bars >= 24)
+        {
+            for (int bar = 0; bar < bars; bar++)
+            {
+                int16_t x = (int16_t)(start + (span * bar * 4) / ticks) + 5;
+                if (x < 780)
+                {
+                    API_CMD_NUMBER(x, bottom - 15, font->handle, 0, bar + 1);
+                }
+            }
+        }
+    }
+}
+
+void cLoopWave::update()
+{
+    if (data == nullptr)
+    {
+        return;
+    }
+
+    API_SAVE_CONTEXT();
+
+    drawRuler();
+
+    const int16_t mid = posY + height / 2;
+
+    // slice lines, faint, behind the bars
+    const int32_t span = (int32_t)data->regionEndPx - (int32_t)data->regionStartPx;
+    if (data->slices > 1 && span > 0)
+    {
+        API_COLOR(colors[1]);
+        API_COLOR_A(90);
+        API_LINE_WIDTH(8);
+        API_BEGIN(LINES);
+        for (int k = 1; k < data->slices; k++)
+        {
+            int16_t x = (int16_t)(posX + data->regionStartPx + (span * k) / data->slices);
+            API_VERTEX2F(x, posY);
+            API_VERTEX2F(x, posY + height);
+        }
+        API_END();
+    }
+
+    // 200 bars, 3 px wide, mirrored about the centre line
+    API_COLOR(colors[0]);
+    API_LINE_WIDTH(24);
+    API_BEGIN(LINES);
+
+    int8_t lastInside = -1;
+    for (int i = 0; i < strLoopWaveData::kBars; i++)
+    {
+        const int16_t x = posX + i * strLoopWaveData::kBarPitch + 1;
+        const int8_t inside = (x >= posX + data->regionStartPx && x <= posX + data->regionEndPx);
+
+        if (inside != lastInside)
+        {
+            API_COLOR_A(inside ? 255 : 70);
+            lastInside = inside;
+        }
+
+        API_VERTEX2F(x, mid - data->barUp[i]);
+        API_VERTEX2F(x, mid + data->barDown[i]);
+    }
+    API_END();
+
+    API_RESTORE_CONTEXT();
+}
+
+#endif // TRACKER_MINI
diff --git a/core/libs/NewDisplay/loopWaveControl.h b/core/libs/NewDisplay/loopWaveControl.h
new file mode 100644
index 0000000..3382d17
--- /dev/null
+++ b/core/libs/NewDisplay/loopWaveControl.h
@@ -0,0 +1,47 @@
+#ifndef LIBS_NEWDISPLAY_LOOPWAVECONTROL_H_
+#define LIBS_NEWDISPLAY_LOOPWAVECONTROL_H_
+
+#ifdef TRACKER_MINI
+
+#include "displayControls.h"
+
+// Loops screen: the full-width waveform (200 bars), the bar/beat ruler above it and the
+// slice lines. Static: rebuilt only when the instrument, region, bars or slices change.
+struct strLoopWaveData
+{
+    static constexpr int kBars = 200;
+    static constexpr int kBarPitch = 4; // 3 px bar + 1 px gap
+
+    uint8_t barUp[kBars];   // pixels above the centre line
+    uint8_t barDown[kBars]; // pixels below it
+
+    uint16_t regionStartPx = 0; // the loop region; bars outside it are dim
+    uint16_t regionEndPx = 800;
+
+    uint8_t slices = 8;     // slice lines inside the region
+    uint8_t rulerBeats = 0; // beats in the region (FIT); 0 = ticks at the slice edges (FREE)
+};
+
+class cLoopWave : public cDisplayControl
+{
+  public:
+    cLoopWave(strControlProperties* properties);
+    virtual ~cLoopWave();
+
+    virtual void update();
+
+    virtual void setStyle(uint32_t style);
+    virtual void setText(const char* text);
+    virtual void setValue(int value);
+    virtual void setColors(const uint32_t* colors);
+    virtual void setData(void* data);
+
+  private:
