+++ b/core/interface/loops/gLoops.cpp
@@ -0,0 +1,427 @@
+#ifdef TRACKER_MINI
+
+#include "loops/loops.h"
+
+#include <stdio.h>
+#include <string.h>
+
+#include "mtAudioEngine.h"
+#include "mtSequencer.h"
+
+// Layout, 800 x 480 (docs: tracker-mini/docs/DESIGN.md section 3)
+static constexpr uint16_t kInfoY = 34;
+static constexpr uint16_t kInfoH = 32;
+static constexpr uint16_t kWaveY = 92;
+static constexpr uint16_t kWaveH = 280;
+static constexpr uint16_t kStripY = 378;
+static constexpr uint16_t kStripH = 40;
+
+static constexpr uint32_t kColorLoop = 0x30CB3F;
+static constexpr uint32_t kColorArmed = 0xFEF749;
+static constexpr uint32_t kColorArmedDim = 0x6E6B20;
+
+// Colour tables handed to the controls. Filled from the active theme each time the screen opens.
+static uint32_t headColors[4];
+static uint32_t stripColors[4];
+static uint32_t waveColors[2];
+static uint32_t softKeyColors[4];
+static uint32_t infoColors[4];
+static uint32_t badgeColors[4];
+
+static const char* const directionNames[loops::dirCount] = { "FORWARD", "REVERSE", "PING-PONG" };
+static const char* const softKeyNames[4] = { "Direction", "Sync", "Slices", "Track" };
+static const char* const trackNames[8] = { "1", "2", "3", "4", "5", "6", "7", "8" };
+static const char* const barsNames[loops::kBarChoices] = { "1/4 BAR", "1/2 BAR", "1 BAR", "2 BARS",
+                                                          "4 BARS",  "8 BARS",  "16 BARS" };
+
+void cLoops::initDisplayControls()
+{
+    const auto& theme = display.getTheme();
+
+    headColors[0] = theme.waveformProgressColors[0];
+    headColors[1] = theme.waveformProgressColors[1];
+    headColors[2] = kColorArmed;
+    headColors[3] = kColorLoop;
+
+    stripColors[0] = theme.activeLabelsColors[3];
+    stripColors[1] = theme.activeLabelsColors[0];
+    stripColors[2] = theme.activeLabelsColors[1];
+    stripColors[3] = theme.waveformProgressColors[1];
+
+    waveColors[0] = theme.waveformColors[0];
+    waveColors[1] = theme.waveformColors[1];
+
+    // soft keys: the value on top is bright, the name below is grey
+    softKeyColors[0] = theme.activeLabelsColors[3];
+    softKeyColors[1] = theme.activeLabelsColors[1];
+    softKeyColors[2] = theme.activeLabelsColors[2];
+    softKeyColors[3] = theme.activeLabelsColors[0];
+
+    for (int i = 0; i < 4; i++)
+    {
+        infoColors[i] = theme.activeLabelsColors[i];
+        badgeColors[i] = theme.activeLabelsColors[i];
+    }
+    infoColors[0] = theme.activeLabelsColors[3];
+
+    strControlProperties prop;
+
+    // The head is created first: the earliest-created control is drawn last, on top.
+    prop.x = 0;
+    prop.y = kWaveY;
+    prop.w = 800;
+    prop.h = kWaveH;
+    prop.style = 0;
+    prop.colors = headColors;
+    prop.data = &headData;
+    headControl = display.createControl<cLoopHead>(&prop);
+
+    prop.y = kStripY;
+    prop.h = kStripH;
+    prop.style = controlStyleFont1;
+    prop.colors = stripColors;
+    prop.data = &stripData;
+    stripControl = display.createControl<cLoopStrip>(&prop);
+
+    prop.y = kWaveY;
+    prop.h = kWaveH;
+    prop.style = controlStyleFont5;
+    prop.colors = waveColors;
+    prop.data = &waveData;
+    waveControl = display.createControl<cLoopWave>(&prop);
+
+    // info row: state, tempo, length and pitch, track
+    strControlProperties prop2;
+    for (uint8_t i = 0; i < 4; i++)
+    {
+        infoText[i][0] = 0;
+        prop2.text = infoText[i];
+        prop2.value = 0;
+        prop2.colors = (i == 0) ? badgeColors : infoColors;
+        prop2.style = (controlStyleCenterY | controlStyleFont2);
+        prop2.x = 200 * i + 12;
+        prop2.y = kInfoY;
+        prop2.w = 188;
+        prop2.h = kInfoH;
+        infoLabel[i] = display.createControl<cLabel>(&prop2);
+    }
+
+    // soft keys over Fn1..Fn4: value on top, name below
+    strControlProperties prop3;
+    for (uint8_t i = 0; i < 4; i++)
+    {
+        prop3.text = (char*)"";
+        prop3.value = 1;
+        prop3.colors = softKeyColors;
+        prop3.style = (controlStyleCenterX | controlStyleCenterY | controlStyleFont4);
+        prop3.x = 200 * i + 100;
+        prop3.y = 424;
+        prop3.w = 194;
+        prop3.h = 55;
+        keyLabel[i] = display.createControl<cLabel>(&prop3);
+        display.setControlStyle2(keyLabel[i],
+                                 (controlStyleCenterX | controlStyleCenterY | controlStyleFont5));
+        display.setControlText2(keyLabel[i], softKeyNames[i]);
+    }
+
+    strControlProperties prop4;
+    prop4.text = nullptr;
+    prop4.colors = nullptr;
+    prop4.value = (1 << 2) | (1 << 4) | (1 << 6); // dividers between the four keys
+    prop4.style = controlStyleNoTransparency | controlStyleShow;
+    prop4.x = 0;
+    prop4.w = 800;
+    prop4.y = 425;
+    prop4.h = 54;
+    bgLabel = display.createControl<cBgLabel>(&prop4);
+
+    strControlProperties prop5;
+    prop5.text = (char*)"";
+    prop5.value = 0;
+    prop5.colors = infoColors;
+    prop5.style = (controlStyleCenterX | controlStyleCenterY | controlStyleFont2);
+    prop5.x = 400;
+    prop5.y = kWaveY;
+    prop5.w = 760;
+    prop5.h = kWaveH;
+    messageLabel = display.createControl<cLabel>(&prop5);
+
+    // everything is drawn afresh by showDefaultScreen()
+    shownState = 255;
+    shownTrack = 255;
+    shownTempo10 = -1;
+}
+
+void cLoops::showDefaultScreen()
+{
+    titleBar->show(true);
+    titleBar->setTitle("Loops");
+    titleBar->showCurrentInstrumentOnRightLabel();
+
+    if (playable)
+    {
+        display.setControlHide(messageLabel);
+        display.refreshControl(messageLabel);
+
+        display.setControlShow(waveControl);
+        display.setControlShow(stripControl);
+        display.setControlShow(headControl);
+        for (uint8_t i = 0; i < 4; i++)
+        {
+            display.setControlShow(infoLabel[i]);
+            display.setControlShow(keyLabel[i]);
+        }
+
+        refreshWave();
+        refreshStrip(stripData.playing, stripData.held, true);
+        refreshSoftKeys();
+        refreshInfo(true);
+        refreshBadge(loopsEngine.status().state, true, true);
+        display.refreshControl(headControl);
+    }
+    else
+    {
+        display.setControlHide(waveControl);
+        display.setControlHide(stripControl);
+        display.setControlHide(headControl);
+        display.refreshControl(waveControl);
+        display.refreshControl(stripControl);
+        display.refreshControl(headControl);
+        for (uint8_t i = 0; i < 4; i++)
+        {
+            display.setControlHide(infoLabel[i]);
+            display.refreshControl(infoLabel[i]);
+            display.setControlHide(keyLabel[i]);
+            display.refreshControl(keyLabel[i]);
+        }
+
+        display.setControlText(messageLabel, message != nullptr ? message : "");
+        display.setControlShow(messageLabel);
+        display.refreshControl(messageLabel);
+    }
+
+    display.refreshControl(bgLabel);
+
+    display.synchronizeRefresh();
+}
+
+void cLoops::hideControlsUnderMiniMenu()
+{
+    // Called by the menu popup every time it shows. Until start() runs again, update()
+    // leaves the hidden controls alone.
+    menuOpen = true;
+
+    display.setControlHide(waveControl);
+    display.setControlHide(stripControl);
+    display.setControlHide(headControl);
+    display.setControlHide(messageLabel);
+
+    display.refreshControl(waveControl);
+    display.refreshControl(stripControl);
+    display.refreshControl(headControl);
+    display.refreshControl(messageLabel);
+}
+
+void cLoops::refreshSoftKeys()
+{
+    display.setControlText(keyLabel[0], directionNames[direction % loops::dirCount]);
+    display.setControlText(keyLabel[1], fitOn ? "FIT" : "FREE");
+    display.setControlText(keyLabel[2], slices == 16 ? "16" : "8");
+    display.setControlText(keyLabel[3], trackNames[track % 8]);
+
+    for (uint8_t i = 0; i < 4; i++)
+    {
+        display.refreshControl(keyLabel[i]);
+    }
+}
+
+void cLoops::refreshBadge(uint8_t state, bool blinkOn, bool force)
+{
+    if (!force && state == shownState && (state != loops::stArmed || blinkOn == shownBlink))
+    {
+        return;
+    }
+    shownState = state;
+    shownBlink = blinkOn;
+
+    const auto& theme = display.getTheme();
+    const char* text = "READY";
+    uint32_t color = theme.activeLabelsColors[0];
+
+    switch (state)
+    {
+        case loops::stArmed:
+            text = "ARMED";
+            color = blinkOn ? kColorArmed : kColorArmedDim;
+            break;
+        case loops::stLoop:
+            text = "LOOP";
+            color = kColorLoop;
+            break;
+        case loops::stStutter:
+            text = "STUTTER";
+            color = theme.waveformProgressColors[1];
+            break;
+        default: break;
+    }
+
+    badgeColors[0] = color;
+    strncpy(infoText[0], text, sizeof(infoText[0]) - 1);
+    infoText[0][sizeof(infoText[0]) - 1] = 0;
+
+    display.setControlText(infoLabel[0], infoText[0]);
+    display.setControlColors(infoLabel[0], badgeColors);
+    display.refreshControl(infoLabel[0]);
+}
+
+void cLoops::refreshInfo(bool force)
+{
+    // tempo
+    const int32_t tempo10 = (int32_t)(tempo * 10.0f + 0.5f);
+    if (force || tempo10 != shownTempo10)
+    {
+        shownTempo10 = tempo10;
+        snprintf(infoText[1], sizeof(infoText[1]), "%d.%d BPM", (int)(tempo10 / 10), (int)(tempo10 % 10));
+        display.setControlText(infoLabel[1], infoText[1]);
+        display.refreshControl(infoLabel[1]);
+        force = true; // the pitch shift follows the tempo
+    }
+
+    // length and pitch shift
+    if (force)
+    {
+        if (fitOn && fit.valid)
+        {
+            int32_t semis10 = (int32_t)(fit.semis * 10.0f + (fit.semis >= 0.0f ? 0.5f : -0.5f));
+            const char sign = (semis10 < 0) ? '-' : '+';
+            if (semis10 < 0)
+            {
+                semis10 = -semis10;
+            }
+            snprintf(infoText[2],
+                     sizeof(infoText[2]),
+                     "%s  %c%d.%d st",
+                     barsNames[barsIndex],
+                     sign,
+                     (int)(semis10 / 10),
+                     (int)(semis10 % 10));
+        }
+        else if (octave != 0)
+        {
+            snprintf(infoText[2], sizeof(infoText[2]), "FREE  %c%d oct", octave > 0 ? '+' : '-', octave > 0 ? octave : -octave);
+        }
+        else
+        {
+            snprintf(infoText[2], sizeof(infoText[2]), "FREE");
+        }
+        display.setControlText(infoLabel[2], infoText[2]);
+        display.refreshControl(infoLabel[2]);
+    }
+
+    // track
+    if (force || track != shownTrack)
+    {
+        shownTrack = track;
+        snprintf(infoText[3], sizeof(infoText[3]), "TRK %d", track + 1);
+        display.setControlText(infoLabel[3], infoText[3]);
+        display.refreshControl(infoLabel[3]);
+    }
+}
+
+void cLoops::refreshWave()
+{
+    waveData.regionStartPx = (uint16_t)(((uint32_t)regionA * 800) / 65536);
+    waveData.regionEndPx = (uint16_t)(((uint32_t)regionB * 800 + 65535) / 65536);
+    waveData.slices = slices;
+    waveData.rulerBeats = (fitOn && fit.valid) ? (uint8_t)loops::quarterBarsAt(barsIndex) : 0;
+
+    display.refreshControl(waveControl);
+}
+
+void cLoops::refreshStrip(int8_t playing, int8_t held, bool force)
+{
+    if (!force && playing == stripData.playing && held == stripData.held &&
+        slices == stripData.count && padBase == stripData.padBase)
+    {
+        return;
+    }
+
+    stripData.count = slices;
+    stripData.padBase = padBase;
+    stripData.playing = playing;
+    stripData.held = held;
+
+    display.refreshControl(stripControl);
+}
+
+// Runs every 16 ms while something moves. Reads the play position from the voice itself, so
+// the line cannot drift away from the sound.
+void cLoops::refreshHead(const LoopsStatus& status, uint16_t dtMs)
+{
+    if (status.fireCount != lastFireCount)
+    {
+        lastFireCount = status.fireCount;
+        head.reset(status.regionStart,
+                   status.regionEnd,
+                   slices,
+                   (direction == loops::dirReverse) ? -1 : 1);
+    }
+
+    int8_t playingSlice = -1;
+
+    if (status.sounding)
+    {
+        const uint16_t pos = instrumentPlayer[status.track].getWavePosition();
+        head.advance(pos, dtMs);
+        playingSlice = (int8_t)loops::sliceAt(pos, regionA, regionB, slices);
+    }
+    else
+    {
+        head.fade(dtMs);
+    }
+
+    const loops::HeadView& view = head.view();
+    const bool seqPlaying = sequencer.isPlay();
+
+    strLoopHeadData next;
+    next.show = status.sounding;
+    next.x16 = view.x16;
+    next.dir = view.dir;
+    next.tailPx = view.tailPx;
+    next.flashStart = (uint8_t)(((uint32_t)view.flashStartMs * 255) / loops::kFlashMs);
+    next.flashEnd = (uint8_t)(((uint32_t)view.flashEndMs * 255) / loops::kFlashMs);
+    next.regionStartPx = (uint16_t)(((uint32_t)status.regionStart * 800) / 65536);
+    next.regionEndPx = (uint16_t)(((uint32_t)status.regionEnd * 800 + 65535) / 65536);
+    next.lamps = 1;
+    next.beat = seqPlaying ? (int8_t)((sequencer.ptrPlayer->globalPos / loops::kStepsPerBeat) % 4) : -1;
+    next.countdownPx = 0;
+    if (status.state == loops::stArmed && seqPlaying)
+    {
+        next.countdownPx = loops::countdownPx(
+          sequencer.ptrPlayer->globalPos, sequencer.ptrPlayer->uStep, status.armQuant);
+        if (next.countdownPx == 0)
+        {
+            next.countdownPx = 1;
+        }
+    }
+
+    const bool changed =
+      next.show != shownHead.show || next.x16 != shownHead.x16 || next.dir != shownHead.dir ||
+      next.tailPx != shownHead.tailPx || next.flashStart != shownHead.flashStart ||
+      next.flashEnd != shownHead.flashEnd || next.regionStartPx != shownHead.regionStartPx ||
+      next.regionEndPx != shownHead.regionEndPx || next.countdownPx != shownHead.countdownPx ||
+      next.beat != shownHead.beat || next.lamps != shownHead.lamps;
+
+    if (changed)
+    {
+        shownHead = next;
+        headData = next;
+        display.refreshControl(headControl);
+    }
+
+    refreshStrip(playingSlice,
+                 (status.state == loops::stStutter) ? (int8_t)status.heldSlice : (int8_t)-1,
+                 false);
+}
+
+#endif // TRACKER_MINI
diff --git a/core/interface/loops/loops.h b/core/interface/loops/loops.h
new file mode 100644
index 0000000..6ce8d6c
--- /dev/null
+++ b/core/interface/loops/loops.h
@@ -0,0 +1,119 @@
+#ifndef INTERFACE_LOOPS_LOOPS_H_
+#define INTERFACE_LOOPS_LOOPS_H_
+
+#ifdef TRACKER_MINI
+
+#include "core/modulesBase.h"
+
+#include "elapsedMillis.h"
+#include "loopHeadControl.h"
+#include "loopStripControl.h"
+#include "loopWaveControl.h"
+
+#include "loops/loopsEngine.h"
+#include "loops/loopsLogic.h"
+
+// Loops: a looper screen for the Tracker Mini. It shows the current instrument's sample as
+// one full-width waveform and loops it forward, reversed or ping-pong on one track voice,
+// with a playhead that follows the voice. Fn1..4 are soft keys, the four value keys are pads.
+class cLoops : public ModuleBase
+{
+  public:
+    virtual void update();
+    virtual void start(uint32_t options);
+    virtual void stop();
+
+    virtual void initDisplayControls();
+    virtual void destroyDisplayControls() {}
+    virtual void hideControlsUnderMiniMenu();
+
+    cLoops() {}
+    ~cLoops() {}
+
+    //---------------------------------- graphics (gLoops.cpp)
+    void showDefaultScreen();
+    void refreshSoftKeys();
+    void refreshInfo(bool force);
+    void refreshBadge(uint8_t state, bool blinkOn, bool force);
+    void refreshWave();
+    void refreshStrip(int8_t playing, int8_t held, bool force);
+    void refreshHead(const LoopsStatus& status, uint16_t dtMs);
+
+    //---------------------------------- logic (fLoops.cpp)
+    void setInputs();
+    void loadInstrument();
+    void computeFit();
+    LoopsConfig makeConfig();
+    void applyConfig(bool rearm);
+
+    void toggleLoop();
+    void nextDirection();
+    void toggleSync();
+    void toggleSlices();
+    void nextTrack();
+    void changeSpeed(int8_t direction);
+    void movePads(int8_t direction);
+    void padKey(uint8_t pad, uint8_t state);
+
+    //---------------------------------- controls
+    hControl headControl = -1;
+    hControl stripControl = -1;
+    hControl waveControl = -1;
+    hControl infoLabel[4] = { -1, -1, -1, -1 };
+    hControl keyLabel[4] = { -1, -1, -1, -1 };
+    hControl bgLabel = -1;
+    hControl messageLabel = -1;
+
+    strLoopHeadData headData;
+    strLoopStripData stripData;
+    strLoopWaveData waveData;
+
+    char infoText[4][28];
+    const char* message = nullptr;
+
+    //---------------------------------- settings (kept until power off, never saved)
+    uint8_t track = 7;
+    uint8_t direction = loops::dirForward;
+    bool fitOn = false;
+    int8_t barsIndex = 2;
+    int8_t octave = 0;
+    uint8_t slices = 8;
+    uint8_t padBase = 0;
+
+    //---------------------------------- the loaded instrument
+    bool playable = false;
+    uint8_t instr = 0;
+    uint16_t regionA = 0;
+    uint16_t regionB = 65535;
+    uint32_t sampleFrames = 0;
+    loops::FitResult fit = { false, 0.0f, 0, 0 };
+    float tempo = 0.0f;
+
+    //---------------------------------- keys
+    bool menuOpen = false;
+    bool fnShift[4] = { false, false, false, false };
+    uint8_t navDown = 0;
+    uint8_t padMask = 0;
+    int8_t currentPad = -1;
+
+    //---------------------------------- what is on the screen now
+    loops::HeadModel head;
+    uint16_t lastFireCount = 0;
+    elapsedMillis headTimer;
+    elapsedMillis blinkTimer;
+    bool headWasActive = false;
+    uint8_t shownState = 255;
+    bool shownBlink = false;
+    uint8_t shownTrack = 255;
+    int32_t shownTempo10 = -1;
+    strLoopHeadData shownHead;
+
+    strZoomParams zoom;
+    strTrackerSpectrum spectrum[2];
+};
+
+extern cLoops loopsScreen;
+
+#endif // TRACKER_MINI
+
+#endif /* INTERFACE_LOOPS_LOOPS_H_ */
