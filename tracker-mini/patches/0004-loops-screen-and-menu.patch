+#include "mtStructs.h"
+
+cLoops loopsScreen;
+static cLoops* LS = &loopsScreen;
+
+static constexpr uint32_t kHeadRefreshMs = 16;
+static constexpr uint32_t kArmedBlinkMs = 125; // 4 Hz
+static constexpr int8_t kMaxOctave = 2;
+
+static constexpr uint8_t kNavMiddle = 1;
+static constexpr uint8_t kNavUp = 2;
+static constexpr uint8_t kNavDown = 4;
+
+static void functSwitchModule(uint8_t button);
+static void functMenu(uint8_t state);
+static void functPlayAction();
+static void functMiddle(uint8_t state);
+static void functUp(uint8_t state);
+static void functDown(uint8_t state);
+static void functLeft();
+static void functRight();
+static void functFn(uint8_t button, uint8_t state);
+static void functValueKey(uint8_t button, uint8_t state);
+
+//==================================================================================================
+// module life cycle
+//==================================================================================================
+void cLoops::start(uint32_t options)
+{
+    (void)options;
+    moduleRefresh = 1;
+    menuOpen = false;
+    navDown = 0;
+
+    setInputs();
+
+    // The menu calls start() again when you pick the screen you are already on: keep a
+    // running loop running in that case.
+    const bool sameSession =
+      loopsEngine.isOpen() && playable && instr == mtProject.values.lastUsedInstrument;
+
+    if (!sameSession)
+    {
+        loopsEngine.close();
+        memset(fnShift, 0, sizeof(fnShift));
+        padMask = 0;
+        currentPad = -1;
+        stripData.playing = -1;
+        stripData.held = -1;
+
+        loadInstrument();
+
+        if (playable)
+        {
+            tempo = sequencer.getCurrentTempo();
+            computeFit();
+            loopsEngine.open(makeConfig());
+
+            lastFireCount = loopsEngine.status().fireCount;
+            head.reset(regionA, regionB, slices, 1);
+        }
+    }
+
+    headData = strLoopHeadData();
+    headData.lamps = playable ? 1 : 0;
+    headData.regionStartPx = (uint16_t)(((uint32_t)regionA * 800) / 65536);
+    headData.regionEndPx = (uint16_t)(((uint32_t)regionB * 800 + 65535) / 65536);
+    shownHead = headData;
+    headTimer = 0;
+    blinkTimer = 0;
+
+    showDefaultScreen();
+}
+
+void cLoops::stop()
+{
+    // The loop stops when you leave (it is cut only if the voice is still ours).
+    loopsEngine.close();
+
+    moduleRefresh = 0;
+    padMask = 0;
+    currentPad = -1;
+
+    // Mini: clearAllButtons() leaves Fn1..4 and the value keys alone, so hand them back
+    // to their stock jobs here.
+    mtInterface.initSpecialMiniTrackerButtons();
+}
+
+void cLoops::setInputs()
+{
+    ip->setButtonObj(interfaceButtonParams, buttonPress, functSwitchModule);
+    ip->setButtonObj(interfaceButtonPerformance, buttonPress, functSwitchModule);
+    ip->setButtonObj(interfaceButtonFile, buttonPress, functSwitchModule);
+    ip->setButtonObj(interfaceButtonConfig, buttonPress, functSwitchModule);
+    ip->setButtonObj(interfaceButtonMaster, buttonPress, functSwitchModule);
+    ip->setButtonObj(interfaceButtonSamplePlay, buttonPress, functSwitchModule);
+    ip->setButtonObj(interfaceButtonSampleEdit, buttonPress, functSwitchModule);
+    ip->setButtonObj(interfaceButtonSampleRec, buttonPress, functSwitchModule);
+    ip->setButtonObj(interfaceButtonSampleLoad, buttonPress, functSwitchModule);
+    ip->setButtonObj(interfaceButtonSong, buttonPress, functSwitchModule);
+    ip->setButtonObj(interfaceButtonPattern, buttonPress, functSwitchModule);
+    ip->setButtonObj(interfaceButtonGame, buttonPress, functSwitchModule);
+
+    ip->setButtonObj(interfaceButtonMiniMenu, functMenu);
+
+    ip->setButtonObj(interfaceButtonPlay, buttonPress, functPlayAction);
+
+    ip->setButtonObj(interfaceButtonMiniMiddle, functMiddle);
+    ip->setButtonObj(interfaceButtonUp, functUp);
+    ip->setButtonObj(interfaceButtonDown, functDown);
+    ip->setButtonObj(interfaceButtonLeft, buttonPress, functLeft);
+    ip->setButtonObj(interfaceButtonRight, buttonPress, functRight);
+
+    // Inside Loops the plain Fn keys are soft keys and the value keys are pads.
+    ip->setButtonObj(interfaceButtonMiniFn1, functFn);
+    ip->setButtonObj(interfaceButtonMiniFn2, functFn);
+    ip->setButtonObj(interfaceButtonMiniFn3, functFn);
+    ip->setButtonObj(interfaceButtonMiniFn4, functFn);
+
+    ip->setButtonObj(interfaceButtonMiniPlus10, functValueKey);
+    ip->setButtonObj(interfaceButtonMiniPlus1, functValueKey);
+    ip->setButtonObj(interfaceButtonMiniMinus1, functValueKey);
+    ip->setButtonObj(interfaceButtonMiniMinus10, functValueKey);
+}
+
+void cLoops::update()
+{
+    if (!playable || menuOpen)
+    {
+        return;
+    }
+
+    const LoopsStatus status = loopsEngine.status();
+
+    // follow the tempo: in FIT the next note fired uses the new pitch
+    const float nowTempo = sequencer.getCurrentTempo();
+    if (fabsf(nowTempo - tempo) > 0.01f)
+    {
+        tempo = nowTempo;
+        if (fitOn)
+        {
+            computeFit();
+            loopsEngine.setConfig(makeConfig());
+            refreshSoftKeys();
+            refreshWave();
+        }
+        refreshInfo(true);
+    }
+
+    refreshBadge(status.state, ((uint32_t)blinkTimer / kArmedBlinkMs) % 2 == 0, false);
+
+    const bool active = status.sounding || status.state == loops::stArmed ||
+                        head.view().flashStartMs > 0 || head.view().flashEndMs > 0 ||
+                        sequencer.isPlay();
+
+    if (headTimer >= kHeadRefreshMs && (active || headWasActive))
+    {
+        uint32_t dt = headTimer;
+        headTimer = 0;
+        if (dt > 250)
+        {
+            dt = 250;
+        }
+        refreshHead(status, (uint16_t)dt);
+        headWasActive = active;
+    }
+}
+
+//==================================================================================================
+// the instrument
+//==================================================================================================
+void cLoops::loadInstrument()
+{
+    playable = false;
+    message = nullptr;
+    instr = mtProject.values.lastUsedInstrument;
+
+    if (instr >= kSampleInstrumentsCount)
+    {
+        message = "Loops plays sample instruments. Pick a sample instrument first.";
+        return;
+    }
+
+    strInstrument* instrument = &mtProject.instrument[instr];
+    strSampleMemory* sampleMemory = &mtProject.sampleMemory[instr];
+
+    if (instrument->isActive != 1 || instrument->sample.length == 0)
+    {
+        message = "This instrument slot is empty. Load a sample first.";
+        return;
+    }
+    if (instrument->sample.type != mtSampleTypeWaveFile ||
+        instrument->playMode == playModeWavetable || instrument->playMode == playModeGranular)
+    {
+        message = "Wavetable and granular instruments cannot be looped here.";
+        return;
+    }
+    if (sampleMemory->isStreamed)
+    {
+        message = "This sample streams from the card. Loops needs a sample held in memory.";
+        return;
+    }
+    if (!loops::regionPlayable(instrument->startPoint, instrument->endPoint))
+    {
+        message = "The start and end points are too close together.";
+        return;
+    }
+
+    regionA = instrument->startPoint;
+    regionB = instrument->endPoint;
+    sampleFrames = instrument->sample.length;
+
+    // The stock code turns the sample into 600 columns per channel; we fold them to 200 bars.
+    spectrum[0].init();
+    spectrum[1].init();
+    GP.spectrumResetZoom(0, instrument->sample.length, &zoom);
+    GP.processSpectrum(
+      sampleMemory, instrument, &zoom, &spectrum[0], strSampleMemory::Channel::kLeft);
+
+    const bool stereo = newFileManager.isInstrumentStereo(instr);
+    if (stereo)
+    {
+        GP.processSpectrum(
+          sampleMemory, instrument, &zoom, &spectrum[1], strSampleMemory::Channel::kRight);
+    }
+
+    loops::reduceBars(spectrum[0].upperData,
+                      spectrum[0].lowerData,
+                      stereo ? spectrum[1].upperData : nullptr,
+                      stereo ? spectrum[1].lowerData : nullptr,
+                      waveData.barUp,
+                      waveData.barDown);
+
+    if (padBase + strLoopStripData::kPads > slices)
+    {
+        padBase = 0;
+    }
+
+    playable = true;
+}
+
+void cLoops::computeFit()
+{
+    if (!fitOn)
+    {
+        fit.valid = false;
+        return;
+    }
+
+    fit = loops::fitToBars(sampleFrames, regionA, regionB, tempo, loops::quarterBarsAt(barsIndex));
+    if (fit.valid)
+    {
+        return;
+    }
+
+    // the tempo moved this bar count out of range: take the nearest one that works
+    const int best = loops::autoBarsIndex(sampleFrames, regionA, regionB, tempo);
+    if (best < 0)
+    {
+        fitOn = false;
+        return;
+    }
+    barsIndex = (int8_t)best;
+    fit = loops::fitToBars(sampleFrames, regionA, regionB, tempo, loops::quarterBarsAt(barsIndex));
+}
+
+LoopsConfig cLoops::makeConfig()
+{
+    LoopsConfig config;
+    config.instr = instr;
+    config.track = track;
+    config.direction = direction;
+    config.slices = slices;
+    config.fit = (fitOn && fit.valid) ? 1 : 0;
+    config.fitSemitones = fit.semitones;
+    config.fitCents = fit.cents;
+    config.octave = octave;
+    config.cycleSteps =
+      config.fit ? loops::cycleSteps(loops::quarterBarsAt(barsIndex), direction) : 0;
+    return config;
+}
+
+void cLoops::applyConfig(bool rearm)
+{
+    computeFit();
+    loopsEngine.setConfig(makeConfig());
+    if (rearm)
+    {
+        loopsEngine.post(LoopsEngine::ecRearm);
+    }
+
+    refreshSoftKeys();
+    refreshInfo(true);
+    refreshWave();
+    refreshStrip(stripData.playing, stripData.held, true);
+}
+
+//==================================================================================================
+// what the keys do
+//==================================================================================================
+void cLoops::toggleLoop()
+{
+    loopsEngine.post(LoopsEngine::ecToggle);
+}
+
+void cLoops::nextDirection()
+{
+    direction = (uint8_t)((direction + 1) % loops::dirCount);
+    applyConfig(true);
+}
+
+void cLoops::toggleSync()
+{
+    if (!fitOn)
+    {
+        const int best = loops::autoBarsIndex(sampleFrames, regionA, regionB, tempo);
+        if (best < 0)
+        {
+            return; // no bar count is within two octaves: stay FREE
+        }
+        barsIndex = (int8_t)best;
+        fitOn = true;
+    }
+    else
+    {
+        fitOn = false;
+    }
+    applyConfig(true);
+}
+
+void cLoops::toggleSlices()
+{
+    if (slices == 8)
+    {
+        slices = 16;
+        padBase = (uint8_t)(padBase * 2);
+    }
+    else
+    {
+        slices = 8;
+        padBase = (uint8_t)((padBase / 8) * 4);
+    }
+    if (padBase + strLoopStripData::kPads > slices)
+    {
+        padBase = (uint8_t)(slices - strLoopStripData::kPads);
+    }
+    applyConfig(false);
+}
+
+void cLoops::nextTrack()
+{
+    track = (uint8_t)((track + 1) % 8);
+    loopsEngine.post(LoopsEngine::ecTrack, track);
+    refreshSoftKeys();
+    refreshInfo(true);
+}
+
+// direction +1 = twice as fast, -1 = half speed
+void cLoops::changeSpeed(int8_t dir)
+{
+    if (fitOn)
+    {
+        // faster = fewer bars
+        const int8_t wanted = (int8_t)(barsIndex - dir);
+        if (wanted < 0 || wanted >= loops::kBarChoices)
+        {
+            return;
+        }
+        if (!loops::fitToBars(sampleFrames, regionA, regionB, tempo, loops::quarterBarsAt(wanted))
+               .valid)
+        {
+            return; // more than two octaves away
+        }
+        barsIndex = wanted;
+    }
+    else
+    {
+        const int8_t wanted = (int8_t)(octave + dir);
+        if (wanted < -kMaxOctave || wanted > kMaxOctave)
+        {
+            return;
+        }
+        octave = wanted;
+    }
+    applyConfig(true);
+}
+
+void cLoops::movePads(int8_t dir)
+{
+    const int wanted = (int)padBase + dir * strLoopStripData::kPads;
+    if (wanted < 0 || wanted + strLoopStripData::kPads > slices)
+    {
+        return;
+    }
+    padBase = (uint8_t)wanted;
+    refreshStrip(stripData.playing, stripData.held, true);
+}
+
+void cLoops::padKey(uint8_t pad, uint8_t state)
+{
+    if (!playable || pad >= strLoopStripData::kPads)
+    {
+        return;
+    }
+
+    const uint8_t bit = (uint8_t)(1 << pad);
+
+    if (state == buttonPress)
+    {
+        padMask |= bit;
+        currentPad = (int8_t)pad;
+        loopsEngine.post(LoopsEngine::ecPadDown, (uint8_t)(padBase + pad));
+    }
+    else if (state == buttonRelease)
+    {
+        if (!(padMask & bit))
+        {
+            return;
+        }
+        padMask &= (uint8_t)~bit;
+
+        if (padMask == 0)
+        {
+            currentPad = -1;
+            loopsEngine.post(LoopsEngine::ecPadUp);
+        }
+        else if (pad == currentPad)
+        {
+            // another pad is still held: go on with that one
+            for (uint8_t i = 0; i < strLoopStripData::kPads; i++)
+            {
+                if (padMask & (1 << i))
+                {
+                    currentPad = (int8_t)i;
+                    loopsEngine.post(LoopsEngine::ecPadDown, (uint8_t)(padBase + i));
+                    break;
+                }
+            }
+        }
+    }
+    // buttonHold: ignored
+}
+
+//==================================================================================================
+// input callbacks
+//==================================================================================================
+static void functSwitchModule(uint8_t button)
+{
+    LS->eventFunct(eventSwitchModule, LS, &button, 0);
+}
+
+static void functMenu(uint8_t state)
+{
+    if (state == buttonPress)
+    {
+        mtMenuPopup.showModulePopup(LS);
+    }
+    else if (state == buttonRelease)
+    {
+        mtMenuPopup.hideModulePopup(LS);
+    }
+}
+
+// Stock Play. A running loop starts again with the pattern, on its first step: the state
+// machine sees the pattern start from the audio side.
+static void functPlayAction()
+{
+    if (sequencer.getSeqState() == Sequencer::SEQ_STATE_STOP)
+    {
+        for (uint8_t i = 0; i < 8; i++)
+        {
+            instrumentPlayer[i].noteOff(Sequencer::STEP_NOTE_OFF_CUT);
+        }
+
+        if (LS->buttons->isButtonPressed(interfaceButtonShift))
+        {
+            sequencer.playSong();
+        }
+        else
+        {
+            sequencer.playPattern();
+        }
+    }
+    else
+    {
+        sequencer.stop();
+    }
+}
+
+// The D-pad and Middle auto-repeat as presses while held. Middle, Up and Down act once per
+// press here; Left and Right may repeat.
+static bool navPressedOnce(uint8_t bit, uint8_t state)
+{
+    if (state == buttonRelease)
+    {
+        LS->navDown &= (uint8_t)~bit;
+        return false;
+    }
+    if (state != buttonPress || (LS->navDown & bit))
+    {
+        return false;
+    }
+    LS->navDown |= bit;
+    return true;
+}
+
+static void functMiddle(uint8_t state)
+{
+    if (navPressedOnce(kNavMiddle, state) && LS->playable)
+    {
+        LS->toggleLoop();
+    }
+}
+
+static void functUp(uint8_t state)
+{
+    if (navPressedOnce(kNavUp, state) && LS->playable)
+    {
+        LS->changeSpeed(1);
+    }
+}
+
+static void functDown(uint8_t state)
+{
+    if (navPressedOnce(kNavDown, state) && LS->playable)
+    {
+        LS->changeSpeed(-1);
+    }
+}
+
+static void functLeft()
+{
+    if (LS->playable)
+    {
+        LS->movePads(-1);
+    }
+}
+
+static void functRight()
+{
+    if (LS->playable)
+    {
+        LS->movePads(1);
+    }
+}
+
+static void functFn(uint8_t button, uint8_t state)
+{
+    if (button < interfaceButtonMiniFn1 || button > interfaceButtonMiniFn4)
+    {
+        return;
+    }
+    const uint8_t n = (uint8_t)(button - interfaceButtonMiniFn1);
+
+    if (state == buttonPress)
+    {
+        LS->fnShift[n] = LS->buttons->isButtonPressed(interfaceButtonShift);
+    }
+
+    const bool shifted = LS->fnShift[n];
+
+    if (state == buttonRelease)
+    {
+        LS->fnShift[n] = false;
+    }
+
+    if (shifted)
+    {
+        // Shift + Fn keeps its stock job: the Shift-layer module shortcut. This may leave
+        // the screen, so nothing of ours is touched after the call.
+        LS->ip->processButtonsInput(
+          InterfaceMenuPopup::modules[mtConfig.interface.functionKeysBinding[4 + n]].button, state);
+        return;
+    }
+
+    if (state != buttonPress || !LS->playable || mtMenuPopup.isPopupVisible())
+    {
+        return;
+    }
+
+    switch (n)
+    {
+        case 0: LS->nextDirection(); break;
+        case 1: LS->toggleSync(); break;
+        case 2: LS->toggleSlices(); break;
+        case 3: LS->nextTrack(); break;
+        default: break;
+    }
+}
+
+static void functValueKey(uint8_t button, uint8_t state)
+{
+    static const int8_t amounts[strLoopStripData::kPads] = { 10, 1, -1, -10 };
+
+    if (button < interfaceButtonMiniPlus10 || button > interfaceButtonMiniMinus10)
+    {
+        return;
+    }
+    const uint8_t pad = (uint8_t)(button - interfaceButtonMiniPlus10);
+
+    // a pad that went down as a pad always comes up as a pad
+    if (state == buttonRelease && (LS->padMask & (1 << pad)))
+    {
+        LS->padKey(pad, state);
+        return;
+    }
+
+    if (LS->buttons->isButtonPressed(interfaceButtonShift))
+    {
+        // stock: Shift + value key = master volume
+        if (state == buttonPress || state == buttonHold)
+        {
+            mtInterface.changeMasterVolume(amounts[pad]);
+        }
+        return;
+    }
+
+    if (mtMenuPopup.isPopupVisible())
+    {
+        // stock: the value keys move the menu selection
+        if (state == buttonPress || state == buttonHold)
+        {
+            LS->ip->processPotsInput(interfacePot0, amounts[pad], state);
+        }
+        else if (state == buttonRelease)
+        {
+            LS->ip->processPotsInput(interfacePot0, 0, state);
+        }
+        return;
+    }
+
+    LS->padKey(pad, state);
+}
+
+#endif // TRACKER_MINI
diff --git a/core/interface/loops/gLoops.cpp b/core/interface/loops/gLoops.cpp
new file mode 100644
index 0000000..c787276
