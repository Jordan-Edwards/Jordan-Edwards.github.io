+uint16_t refireTolerance(uint16_t a, uint16_t b, uint16_t quarterBars, float bpm)
+{
+    float seconds = passSeconds(quarterBars, bpm);
+    if (b <= a || seconds <= 0.0f)
+        return 0;
+
+    float span = (float)(b - a);
+    float tol = span * (kRefireTolMs / 1000.0f) / seconds;
+    if (tol > span / 8.0f)
+        tol = span / 8.0f;
+    return (uint16_t)tol;
+}
+
+bool loopInPhase(uint16_t pos, uint16_t a, uint16_t b, uint8_t direction, uint16_t tol)
+{
+    if (b <= a)
+        return false;
+
+    int32_t fromStart = (int32_t)pos - (int32_t)a;
+    int32_t fromEnd = (int32_t)b - (int32_t)pos;
+    if (fromStart < 0)
+        fromStart = -fromStart;
+    if (fromEnd < 0)
+        fromEnd = -fromEnd;
+
+    if (fromStart <= (int32_t)tol)
+        return true;
+    return direction != dirPingPong && fromEnd <= (int32_t)tol;
+}
